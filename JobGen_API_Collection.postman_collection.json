      {
        "name": "Story Bank",
        "item": [
          {
            "name": "Create Story",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "    const response = pm.response.json();",
                    "    pm.collectionVariables.set('story_id', response.story_id);",
                    "    console.log('Story ID saved:', response.story_id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"interview_id\": \"{{interview_id}}\",\n  \"question_id\": \"q_1\",\n  \"response_id\": \"resp_1\",\n  \"title\": \"Leading a Team Under Pressure\",\n  \"transcript\": \"I once led a team project where we had to deliver results under tight deadlines. I organized daily stand-ups, delegated tasks effectively, and ensured clear communication. We delivered the project two days early.\",\n  \"tags\": [\"leadership\", \"teamwork\", \"deadline-management\"]\n}"
              },
              "url": {
                "raw": "{{base_url}}/story-bank",
                "host": ["{{base_url}}"],
                "path": ["story-bank"]
              }
            }
          },
          {
            "name": "Get All Stories",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/story-bank?page=1&size=10",
                "host": ["{{base_url}}"],
                "path": ["story-bank"],
                "query": [
                  {
                    "key": "page",
                    "value": "1"
                  },
                  {
                    "key": "size",
                    "value": "10"
                  }
                ]
              }
            }
          },
