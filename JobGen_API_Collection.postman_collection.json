      {
        "name": "Interview Management",
        "item": [
          {
            "name": "Create Interview Session",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "    const response = pm.response.json();",
                    "    pm.collectionVariables.set('interview_id', response.interview_id);",
                    "    console.log('Interview ID saved:', response.interview_id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"type\": \"behavioral\",\n  \"duration_seconds\": 1800,\n  \"question_count\": 5\n}"
              },
              "url": {
                "raw": "{{base_url}}/interviews",
                "host": ["{{base_url}}"],
                "path": ["interviews"]
              }
            }
          },
          {
            "name": "Generate Questions",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                },
                {
                  "key": "Authorization",
                  "value": "Bearer {{jwt_token}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"type\": \"behavioral\",\n  \"count\": 5\n}"
              },
              "url": {
                "raw": "{{base_url}}/questions/{{interview_id}}/questions",
                "host": ["{{base_url}}"],
                "path": ["questions", "{{interview_id}}", "questions"]
              }
            }
          },
          {
            "name": "Submit Interview Responses",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"responses\": [\n    {\n      \"question_id\": \"q_1\",\n      \"text\": \"I once led a team project where we had to deliver results under tight deadlines. I organized daily stand-ups to track progress, delegated tasks based on team members' strengths, and ensured clear communication throughout. We delivered the project two days early with high quality.\",\n      \"elapsed_seconds\": 120\n    },\n    {\n      \"question_id\": \"q_2\",\n      \"text\": \"In my previous role, I handled a conflict between team members by first listening to both perspectives individually, then facilitating a constructive meeting where we found common ground. This improved team dynamics and productivity.\",\n      \"elapsed_seconds\": 150\n    }\n  ]\n}"
              },
              "url": {
                "raw": "{{base_url}}/interviews/{{interview_id}}/submit",
                "host": ["{{base_url}}"],
                "path": ["interviews", "{{interview_id}}", "submit"]
              }
            }
          },
          {
            "name": "Get Interview Feedback",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/interviews/{{interview_id}}/feedback",
                "host": ["{{base_url}}"],
                "path": ["interviews", "{{interview_id}}", "feedback"]
              }
            }
          }
        ]
      },
      {
        "name": "Question Hints",
        "item": [
