                "host": ["{{base_url}}"],
                "path": ["story-bank", "{{story_id}}"]
              }
            }
          },
          {
            "name": "Update Story",
            "request": {
              "method": "PUT",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"title\": \"Updated: Leading Through Challenges\",\n  \"transcript\": \"Updated transcript with more details about how I handled the situation, including specific metrics and outcomes.\",\n  \"tags\": [\"leadership\", \"problem-solving\", \"adaptability\"]\n}"
              },
              "url": {
                "raw": "{{base_url}}/story-bank/{{story_id}}",
                "host": ["{{base_url}}"],
                "path": ["story-bank", "{{story_id}}"]
              }
            }
          },
          {
            "name": "Delete Story",
            "request": {
              "method": "DELETE",
              "header": [
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/story-bank/{{story_id}}",
                "host": ["{{base_url}}"],
                "path": ["story-bank", "{{story_id}}"]
              }
            }
          }
        ]
