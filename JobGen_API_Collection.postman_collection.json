              },
              "url": {
                "raw": "{{base_url}}/questions/{{interview_id}}/questions/{{interview_id}}_q_1/hint",
                "host": ["{{base_url}}"],
                "path": ["questions", "{{interview_id}}", "questions", "{{interview_id}}_q_1", "hint"]
              }
            }
          }
        ]
