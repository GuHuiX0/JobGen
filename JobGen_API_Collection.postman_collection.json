      {
        "name": "Signed URLs (S3)",
        "item": [
          {
            "name": "Generate Signed URL (Generic)",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"key\": \"users/{{user_id}}/interviews/{{interview_id}}/audio/resp_1.webm\",\n  \"operation\": \"put\",\n  \"contentType\": \"audio/webm\",\n  \"expiresIn\": 3600\n}"
              },
              "url": {
                "raw": "{{base_url}}/signed-url",
                "host": ["{{base_url}}"],
                "path": ["signed-url"]
              }
            }
          },
          {
            "name": "Generate Audio Upload URL",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "x-user-id",
                  "value": "{{user_id}}"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"interview_id\": \"{{interview_id}}\",\n  \"response_id\": \"resp_1\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/signed-url/audio",
                "host": ["{{base_url}}"],
                "path": ["signed-url", "audio"]
              }
            }
          },
          {
            "name": "Get Download URL",
            "request": {
              "method": "GET",
              "header": [],
              "url": {
                "raw": "{{base_url}}/signed-url/users/{{user_id}}/interviews/{{interview_id}}/audio/resp_1.webm?expiresIn=3600",
                "host": ["{{base_url}}"],
                "path": ["signed-url", "users", "{{user_id}}", "interviews", "{{interview_id}}", "audio", "resp_1.webm"],
                "query": [
                  {
                    "key": "expiresIn",
                    "value": "3600"
                  }
                ]
              }
            }
          },
          {
            "name": "Batch Generate Signed URLs",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"urls\": [\n    {\n      \"key\": \"users/{{user_id}}/interviews/{{interview_id}}/audio/resp_1.webm\",\n      \"operation\": \"get\",\n      \"expiresIn\": 3600\n    },\n    {\n      \"key\": \"users/{{user_id}}/interviews/{{interview_id}}/audio/resp_2.webm\",\n      \"operation\": \"get\",\n      \"expiresIn\": 3600\n    }\n  ]\n}"
              },
              "url": {
                "raw": "{{base_url}}/signed-url/batch",
                "host": ["{{base_url}}"],
